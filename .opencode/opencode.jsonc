{
  "$schema": "https://opencode.ai/config.json",
  "references": {
    "opencode": {
      "repository": "anomalyco/opencode",
      "branch": "dev",
      "description": "Refer for OpenCode implementation details, APIs, and UI behavior."
    },
    "openchamber": {
      "repository": "openchamber/openchamber",
      "branch": "main",
      "description": "a popular 3rd party opensource opencode GUI client app"
    },
    "tasknotes": {
      "repository": "callumalpass/tasknotes",
      "branch": "main",
      "description": "a popular task management obsidian plugin"
    },
    "obsidian-pi": {
      "repository": "ChristianLempa/obsidian-pi",
      "branch": "main",
      "description": "an obsidian plugin that allows chatting with pi agent inside obsidian app"
    },
    "claudian": {
      "repository": "https://github.com/yishentu/claudian",
      "branch" : "main",
      "description": "An Obsidian plugin that embeds Claude Code/Codex as an AI collaborator in your vault"
    }
  },
  "instructions": ["custom-instructions/*.md"]
}
