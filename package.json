{
  "name": "obsidian-opencode-plugin",
  "version": "0.1.1",
  "description": "Obsidian desktop UI for an externally managed OpenCode server.",
  "main": "main.js",
  "scripts": {
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "build:benchmark": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs benchmark",
    "benchmark:record": "node tools/benchmark-proxy/cli.mjs record",
    "benchmark:replay": "node tools/benchmark-proxy/cli.mjs replay",
    "benchmark:run": "node tools/benchmark-runner/cli.mjs",
    "benchmark:metrics": "bash tools/benchmark-metrics/run.sh",
    "benchmark:lifecycle-memory": "node tools/lifecycle-memory/cli.mjs",
    "dev": "node esbuild.config.mjs",
    "dev:benchmark": "node esbuild.config.mjs benchmark-dev",
    "test": "vitest run && node --test tools/benchmark-proxy/proxy.test.mjs tools/benchmark-runner/runner.test.mjs tools/benchmark-metrics/benchmark-metrics.test.mjs tools/lifecycle-memory/lifecycle-memory.test.mjs",
    "test:benchmark-proxy": "node --test tools/benchmark-proxy/proxy.test.mjs",
    "test:benchmark-runner": "node --test tools/benchmark-runner/runner.test.mjs",
    "test:benchmark-metrics": "node --test tools/benchmark-metrics/benchmark-metrics.test.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "obsidian",
    "opencode"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@vitest/coverage-v8": "^2.1.9",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.23.0",
    "jsdom": "^25.0.1",
    "obsidian": "^1.6.7",
    "typescript": "^5.5.3",
    "vitest": "^2.1.9",
    "ws": "^8.21.3"
  }
}
